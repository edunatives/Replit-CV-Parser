# CV Intelligence Parser - Environment Variables

# Google Gemini API Key (for AI-powered CV parsing and assessment)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI API Key (alternative AI provider)
# AI_INTEGRATIONS_OPENAI_API_KEY=your_openai_api_key_here

# LangSmith (optional - for tracing and debugging)
# LANGSMITH_API_KEY=your_langsmith_api_key_here

# MongoDB Connection (for CV storage)
# MONGODB_URI=mongodb://localhost:27017/cv-parser

# Session Secret (for user sessions)
SESSION_SECRET=your_session_secret_here

# Server Configuration
PORT=5000
NODE_ENV=development
